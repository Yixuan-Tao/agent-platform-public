# ============================================================
# 多模态 RAG 系统 — 环境变量配置模板
# 推荐直接使用仓库根目录 .env 的统一 LLM 配置；
# 本文件仅作为 RAG 独立运行的兼容旧变量示例。
# ============================================================

# --- LLM 网关（默认阿里云百炼 OpenAI 兼容接口）---
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
# 或使用官方变量名：DASHSCOPE_API_KEY=your_api_key_here

# --- 模型名称（阿里云百炼）---
QWEN_VL_MODEL=qwen3-vl-plus                    # 多模态视觉理解（OpenAI Vision 兼容）
QWEN_CHAT_MODEL=qwen3.7-plus                   # 生成/重排序/表格摘要
TEXT_EMBED_MODEL=text-embedding-v4             # 文本稠密向量（1024 维）
IMAGE_EMBED_MODEL=tongyi-embedding-vision-plus-2026-03-06 # 多模态向量（DashScope 原生协议），支持 1024 维
# 百炼业务空间 ID（控制台可见）：非空时多模态向量走 maas.aliyuncs.com 新域名原生端点
DASHSCOPE_WORKSPACE_ID=
# 可选：显式指定多模态 Embedding 原生端点（不填则按 WorkspaceId 自动推导）
DASHSCOPE_MULTIMODAL_URL=
# 主检索链路并入图像向量检索（文搜图）：需先完成图片向量回填，再设为 true
ENABLE_VISUAL_SEARCH=false
RERANK_MODEL=qwen3-rerank                      # 重排模型（compatible-api/v1/reranks）
# RERANK_BASE_URL=
# 可信模型网关主机白名单（逗号分隔）；非空时启动自检强制 HTTPS 且主机必须在名单内
# MODEL_GATEWAY_ALLOWED_HOSTS=dashscope.aliyuncs.com

# --- 图片 embedding 开关 ---
# 阿里云多模态 Embedding 不支持 OpenAI 兼容模式，代码自动禁用并走 fallback
# （text-embed 编码图片描述 / 零向量）；如需强制尝试设 DISABLE_IMAGE_EMBED=0
# DISABLE_IMAGE_EMBED=1

# --- VL 并发数 ---
# tests/scripts/test_vl_concurrency.py 实测 sweet spot：0.2x 加速，撞 429 概率低
# 多用户并发摄入场景建议 3
# VL_MAX_WORKERS=5

# --- ChromaDB 配置 ---
CHROMA_DB_PATH=./chroma_data                # ChromaDB 本地持久化目录

# --- 服务配置 ---
HOST=127.0.0.1                # 显式设置优先；LAN_ENABLED=true 且未设置时默认 0.0.0.0
PORT=8010
LOG_LEVEL=INFO
# 默认仅本机访问。局域网共享时必须同时设置 TLS 证书和初始管理员。
# LAN_ENABLED=false
# TLS_CERT_FILE=runtime_data/tls/server.crt
# TLS_KEY_FILE=runtime_data/tls/server.key
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_PASSWORD=replace-with-strong-password
# 可选：供 CI/脚本使用的管理员密钥；不写入资料包或 Git。
# ADMIN_API_KEY=replace-with-rotatable-key
# RUNTIME_DIR=./runtime_data               # 运行时数据目录
# MAX_UPLOAD_BYTES=52428800                # 上传文件大小限制（默认 50MB）
# MAX_INGEST_TASKS=20                       # 活跃摄入任务上限（含排队任务）
# CHAT_TIMEOUT=30                          # LLM 调用超时（秒）
# MAX_TOP_K=20                             # 检索返回最大 chunk 数
# EMBED_BATCH_SIZE=10                      # 单次 embedding 请求输入条数（阿里云 text-embedding-v4 上限 10）

# --- PDF 解析（LiteParse）---
# 文本型 PDF 已有 native text layer，无需 OCR。OCR 关闭可避免 Tesseract 在
# 受限环境下的权限错误（Windows 沙箱常见 os error 5），并显著提升解析速度。
# 扫描件场景：设为 true（需保证 OCR 服务可用）
LITEPARSE_OCR_ENABLED=false
# OCR 失败时是否中断整个解析。true=OCR 完全失败抛错；false=仅用 native text
LITEPARSE_OCR_FAILURE_FATAL=false

# --- Query 改写（Requery — 多路检索增强）---
# 总开关：false 跳过改写，直接用原始 query 检索
# REQUERY_ENABLED=true
# 短查询阈值：query 字符数小于该值时触发改写
# REQUERY_MIN_QUERY_LENGTH=30
# 改写生成的额外 query 数（不含原 query）
# REQUERY_N_VARIANTS=2

# --- 切块策略（heading-aware parent-child）---
# 子 chunk token 上限
# CHUNK_MAX_TOKENS=768
# 表格类 chunk token 上限（表格需保留原始 Markdown）
# TABLE_CHUNK_MAX_TOKENS=3000
# EMC 文档专用文本 chunk 上限（参数密集，适当增大）
# EMC_CHUNK_MAX_TOKENS=1200
# 父 chunk token 上限
# PARENT_MAX_TOKENS=2000
# 是否保留表格原始 Markdown（true 时 content 含 [原始表格] + [表格摘要]）
# ENABLE_TABLE_FULL_CONTENT=true
# 跨页同标题合并
# ENABLE_HEADING_MERGE=true
# 表格独立成 chunk（不与文本聚合）
# ENABLE_TABLE_ISOLATION=true
# 父子双层结构开关
# ENABLE_PARENT_CHILD=true
# heading 切块最小层级（1=H1, 2=H1+H2 切块）
# CHUNK_HEADING_MIN_LEVEL=2

# --- 可选：Langfuse 可观测性 ---
# LANGFUSE_PUBLIC_KEY=pk-xxx
# LANGFUSE_SECRET_KEY=sk-xxx
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- 章节结构识别（标准类大文档对比路由用）---
# Ingestion 阶段给 chunk 标注 section_id / section_path / section_topic
# 关闭后所有 section 字段为空，compare 走全量路由
# ENABLE_SECTION_RECOGNITION=true

# --- 对比场景章节路由总开关 ---
# 启用后，compare() 先按 query 命中 section topic 路由
# 未命中或路由失败时降级到全量对比
# ENABLE_COMPARE_SECTION_ROUTING=true
# 单 section 对比的最大 chunk 数（防单 section 异常膨胀）
# MAX_CHUNKS_PER_SECTION_FOR_EXTRACT=80
