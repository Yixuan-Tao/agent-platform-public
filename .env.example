# ===== 应用 =====
APP_NAME=agent-platform
ENV=dev

# ===== 网关 =====
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=dev-key-change-me
# 服务 API Key 仅代表 service 角色；账号管理等需要 ADMIN_API_KEY 或管理员会话

# ===== 认证 / 审计 / LAN 安全（默认仅本机访问）=====
# 局域网共享时开启；开启后网关与 RAG 服务强制 HTTPS，写操作需登录，审计归属到用户
LAN_ENABLED=false
TLS_CERT_FILE=
TLS_KEY_FILE=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
# 可选：供 CI/脚本使用的自动化管理员密钥；不写入 Git
ADMIN_API_KEY=
# 可选：可信模型网关主机白名单（逗号分隔）；非空时启动自检强制 HTTPS + 主机校验
MODEL_GATEWAY_ALLOWED_HOSTS=

# ===== LLM API（统一配置：网关 / RAG 知识服务 / 记忆全部从这里读取）=====
# 阿里云百炼（DashScope）OpenAI 兼容接口：
#   推荐新域名：https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
#   兼容旧域名：https://dashscope.aliyuncs.com/compatible-mode/v1（默认值，无需 WorkspaceId）
# API Key 在百炼控制台创建（sk- 开头），官方环境变量名为 DASHSCOPE_API_KEY；
# 统一变量 LLM_API_KEY 优先，其次 DASHSCOPE_API_KEY，再次 OPENAI_API_KEY。
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 各角色模型（网关与 RAG 共用）：
CHAT_MODEL=qwen3.7-plus                  # 聊天 / Agent 默认模型（qwen3.7-max / qwen3.7-flash 可选）
VL_MODEL=qwen3-vl-plus                   # 图片理解（多模态解析，OpenAI 兼容）
EMBED_MODEL=text-embedding-v4            # 文本向量（默认 1024 维）
IMAGE_EMBED_MODEL=tongyi-embedding-vision-plus-2026-03-06   # 多模态向量（DashScope 原生协议），支持 1024 维
# 百炼业务空间 ID（控制台可见）：非空时多模态向量走 maas.aliyuncs.com 新域名原生端点
DASHSCOPE_WORKSPACE_ID=
# 可选：显式指定多模态 Embedding 原生端点（不填则按 WorkspaceId 自动推导）
DASHSCOPE_MULTIMODAL_URL=
# 主检索链路并入图像向量检索（文搜图）：需先完成图片向量回填，再设为 true
ENABLE_VISUAL_SEARCH=false
RERANK_MODEL=qwen3-rerank                # 检索重排（阿里云走 compatible-api，单请求最大 500 文档）
# 重排专用网关（可选）：默认由 LLM_BASE_URL 把 compatible-mode 替换为 compatible-api 自动推导；
# 推荐显式填写新业务空间域名：
RERANK_BASE_URL=
# 单次 embedding 请求最大输入条数：阿里云 text-embedding-v4 上限 10，默认 10
EMBED_BATCH_SIZE=10
# 按 Agent 覆盖聊天模型，格式 JSON 对象 {"it_support": "qwen3.7-flash", ...}
MODEL_OVERRIDES={}
LLM_MAX_RETRIES=3
LLM_TIMEOUT=60
CHAT_TIMEOUT=120                        # RAG 生成调用超时（秒；阿里云 qwen3.7-plus 大报告场景建议 120）
# 兼容旧变量名（可选，不填则用上面统一配置）：
# OPENAI_API_KEY / OPENAI_BASE_URL / DEFAULT_MODEL
# RAG 服务旧变量（可选，不填则用上面统一配置）：
# ONEAPI_BASE_URL / ONEAPI_API_KEY / QWEN_CHAT_MODEL / QWEN_VL_MODEL / TEXT_EMBED_MODEL

# ===== 数据库 =====
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent_platform
# Docker Compose 使用（未设置时 postgres 会拒绝启动，属有意为之）
POSTGRES_USER=agent
POSTGRES_PASSWORD=
POSTGRES_DB=agent_platform

# ===== 记忆 =====
REDIS_URL=redis://localhost:6379/0
USE_FAKEREDIS=true
SHORT_MEMORY_TTL_SECONDS=3600

# ===== RAG 知识服务（独立进程）=====
RAG_SERVICE_URL=http://localhost:8010
RAG_RUNTIME_CONTRACT_ENABLED=false
RAG_DELEGATE_MODEL_REQUESTS=8
RAG_DELEGATE_TOKENS=32000
# Docker Compose 专用：容器内访问 RAG 的地址（宿主机的 RAG_SERVICE_URL 不会进容器）
# LAN 模式（RAG 强制 HTTPS）时设为 https://rag:8010
RAG_INTERNAL_URL=http://rag:8010
# 宿主机端口映射（默认 8000/8010/3000）。若与本机其它服务冲突则改这里：
# 例如 qiuzhao-desk 占用 8000 时，设 API_HOST_PORT=18000 并同步设置
# NEXT_PUBLIC_API_URL=http://localhost:18000（前端构建期内联，需重建 web 镜像）
API_HOST_PORT=8000
RAG_HOST_PORT=8010
WEB_HOST_PORT=3000
# 网关根路径索引里显示的前端地址（改了 WEB_HOST_PORT 就同步改这里）
FRONTEND_URL=http://localhost:3000
# 网关调用 RAG 写操作的服务凭据（本机模式作为 X-Local-Token；LAN 模式作为 Bearer）
# Docker Compose 下同时作为 RAG 的 LOCAL_API_TOKEN，两端必须一致
RAG_SERVICE_TOKEN=
# 运行数据目录（access.db / audit.db）；容器中为 /data/runtime_data
RUNTIME_DIR=runtime_data
# 回答流式（按模型 token 增量下发，首字延迟更真实；开启后质检只记录不回滚）
ANSWER_STREAMING=false
# 单次请求的子 Agent 调用次数上限（Router-ReAct / Plan-and-Execute 共用）
AGENT_CALL_BUDGET=8
CHROMA_DIR=chroma_data

# ===== Jira =====
JIRA_URL=
JIRA_USER=
JIRA_TOKEN=

# ===== 可观测性（可选）=====
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ===== 评测裁判（DeepSeek LLM-as-Judge，可选）=====
# 用独立的 DeepSeek 模型对 RAG 回答按规则打分（评测时使用）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat             # 可选 deepseek-v4-flash / deepseek-v4-pro
# 建议钉死模型版本快照并留痕，避免上游漂移静默改变打分（评测结果会记录该值）
DEEPSEEK_MODEL_VERSION=
DEEPSEEK_TIMEOUT=60
JUDGE_PASS_THRESHOLD=4.0                 # 裁判判定"通过"的总分阈值（0-5）
JUDGE_MAX_WORKERS=4                      # 裁判并发数
# 稳定判定：>1 时每条跑 N 次取各维度中位数，抑制单次抖动（回归门禁建议 3）
JUDGE_MEDIAN_RUNS=1
# 可选双裁判仲裁：设置后用第二个模型再判一轮，比对 pass 一致性（arbitrated 字段）
JUDGE_SECOND_MODEL=

# ===== 记忆（长期记忆 few-shot）=====
MEMORY_FEW_SHOT_ENABLED=true             # 长期记忆 few-shot 总开关
MEMORY_FEW_SHOT_K=3                      # 最多注入条数
MEMORY_FEW_SHOT_MIN_SCORE=0.5            # 相关性阈值，低于则丢弃
MEMORY_FEW_SHOT_MAX_TOKENS=500           # 注入上下文 token 上限

# ===== 工具模块 =====
TOOL_CALL_TIMEOUT=30                     # 工具调用超时（秒）
PLUGIN_DIR=                              # 插件目录（扫描 plugin.json 注册沙箱插件）
TOOL_CONFIG=                             # 声明式工具注册（JSON 数组：[{"name","description","module","function"}]）
MCP_SERVERS=                             # 外部 MCP 服务器（JSON 数组：[{"name","transport","url"/"command"}]）

# ===== 编排（Router-as-ReAct 双模式，默认关闭保持单 Agent 路由）=====
USE_ROUTER_REACT=false
MAX_AGENT_CALLS=4
PLAN_MODE=true                           # 复杂任务启用 Plan-and-Execute
MAX_PLAN_STEPS=6
PLANNER_LLM_JUDGE=0                      # 1 时复杂度判定改用 LLM（默认规则启发式）

# ===== 日志 =====
LOG_LEVEL=INFO
LOG_DIR=logs

# ===== 持久化任务与人工触发实验（迁移后启用） =====
RUNS_ENABLED=false
CHAT_VIA_RUNS=false
EXPERIMENTS_ENABLED=false
DEFAULT_RUN_PROFILE=B0
SERVICE_TOOL_SCOPES=[]
USER_TOOL_SCOPES=["jira:read","jira:create"]
# 第二阶段分别启用；不自动触发模型批次或授予权限
SEMANTIC_MEMORY_ENABLED=false
TOOL_DISCOVERY_ENABLED=false
# 仅在 Docker daemon / 固定镜像验收通过后启用，另需 python:execute scope
SANDBOX_ENABLED=false
